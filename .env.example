# Kopieer dit bestand naar .env en vul je eigen gegevens in.
# Het bestand .env komt NOOIT in Git (het staat in .gitignore).

# Jouw persoonlijke API-key. Die krijg je van je docent; hij begint met sk-
AI_API_KEY=sk-vul-hier-je-eigen-key-in

# Adres van de AI-server. Alleen aanpassen als je docent dat zegt.
# AI_BASE_URL=https://ai-pc.taile10d2b.ts.net/v1

# Poort van de app op je eigen computer (standaard 5000).
# PORT=5000
